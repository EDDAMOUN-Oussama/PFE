# Vercel: required. Set the real Render HTTPS origin before the first deployment.
# Browser requests stay on /api; vercel.ts proxies them to this URL.
# Vite: leave blank to use WAMP; set it to a local Docker origin to use Docker.
VITE_API_URL=
# Optional WAMP overrides (auto-detected under C:/wamp64/www by default):
# BACKEND_ORIGIN=http://localhost
# BACKEND_PATH=/pfe/PFE/backend/controllers
