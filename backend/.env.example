# Docker --env-file or Render environment settings. PHP does not auto-load this file.
# WAMP: use config/local.php copied from config/local.example.php instead.
APP_ENV=production
APP_TIMEZONE=Africa/Casablanca
FRONTEND_URL=https://your-project.vercel.app
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Render Secret File named aiven-ca.pem, downloaded from your Aiven service.
DB_SSL_CA=/etc/secrets/aiven-ca.pem
SESSION_SAMESITE=Lax
MAIL_TRANSPORT=brevo
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=HealthyTrack
# Optional SMTP instead of Brevo HTTPS (MAIL_TRANSPORT=smtp):
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
